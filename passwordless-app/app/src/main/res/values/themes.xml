<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Vault Logic uses a strict dark theme -->
    <style name="Base.Theme.PasswordlessApp" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/vault_primary</item>
        <item name="colorOnPrimary">@color/vault_on_primary</item>
        <item name="colorPrimaryContainer">@color/vault_primary</item>
        
        <!-- Secondary brand color (Cyber Lime). -->
        <item name="colorSecondary">@color/vault_accent</item>
        <item name="colorOnSecondary">@color/vault_on_accent</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/vault_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/vault_background</item>
        
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/vault_background</item>
        <item name="android:colorBackground">@color/vault_background</item>
        <item name="colorSurface">@color/vault_surface_low</item>
        <item name="colorOnSurface">@color/vault_on_surface</item>
        <item name="colorOnBackground">@color/vault_on_surface</item>

        <!-- Typography Configuration (Fallback until fonts are downloaded) -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.PasswordlessApp" parent="Base.Theme.PasswordlessApp" />
</resources>
