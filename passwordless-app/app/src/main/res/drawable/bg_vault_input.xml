<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vault_surface_lowest" />
            <stroke android:width="1dp" android:color="@color/vault_accent_dim" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vault_surface_lowest" />
            <stroke android:width="1dp" android:color="@color/vault_outline_variant" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
